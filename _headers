# Netlify Headers for Performance Optimization
# https://docs.netlify.com/routing/headers/

# Cache static assets for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 year
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS for 1 year
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache JavaScript for 1 year
/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML - revalidate frequently
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker - no cache
/sw.js
/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

# Build-version probe - always fetched fresh by the app to detect new deploys
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Crawl-control files - keep GSC and other crawlers seeing fresh directives
/robots.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/xml; charset=utf-8

# Security headers.
# NOTE: no Content-Security-Policy here — the strict meta tag in index.html is the
# single source of truth. GH Pages' header application cache is stale-prone and the
# browser enforces the INTERSECTION of header + meta CSP, so a stale header
# (e.g. without connect.facebook.net) silently blocks features. Keeping CSP only in
# the meta tag eliminates that failure mode. Keep the two in sync when editing.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Permitted-Cross-Domain-Policies: none

# Preconnect hints for faster loading
/*
  Link: <https://fonts.googleapis.com>; rel=preconnect; crossorigin
  Link: <https://fonts.gstatic.com>; rel=preconnect; crossorigin
  Link: <https://aistudiocdn.com>; rel=dns-prefetch
