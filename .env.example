# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ── Firebase (Remote Config only — no auth) ──────────────────────────────────
# Used for maintenance/announcement kill-switch flags. No sign-in anywhere.
# Copy config from Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# ── Community writes (Cloudflare Worker proxy) ───────────────────────────────
# All community writes go through the Cloudflare Worker — repo names and the
# GitHub PAT never reach the browser. Configure via `wrangler secret put`
# (see cloudflare-worker.js header for the variable list: GH_TOKEN,
# DATA_TOKEN, TURNSTILE_SECRET). KoyJabo has no accounts — writes are
# device-gated.
#
# IMPORTANT: never add VITE_GITHUB_TOKEN — Vite inlines every VITE_-prefixed
# variable into the JS bundle, so anything pasted here ships to every visitor.

# Worker URL override (defaults to https://koyjabo-auth-proxy.fagun115946.workers.dev)
VITE_API_PROXY=

# Backend API URL (optional - defaults to production)
VITE_BACKEND_URL=

# Gemini API Keys for AI features (supports key rotation for better load distribution)
# Get your keys from: https://aistudio.google.com/app/apikey
# You can use 1 to 5 keys (use GEMINI_API_KEY for primary key, or all 5 for rotation)

# Primary key (used if only one key is available)
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Additional keys for rotation (optional but recommended)
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
GEMINI_API_KEY_4=your_fourth_gemini_api_key_here
GEMINI_API_KEY_5=your_fifth_gemini_api_key_here

# TomTom API Keys for real-time traffic data (optional)
# Get your keys from: https://developer.tomtom.com/
# These are used for live traffic visualization on the map
VITE_TOMTOM_API_KEY_1=your_tomtom_api_key_1_here
VITE_TOMTOM_API_KEY_2=your_tomtom_api_key_2_here

# ── AdMob (Android app ads — required for Play Store; AdSense banned in apps) ─
# Create units at https://admob.google.com → Apps → Ad units
# Use Google test IDs (ca-app-pub-3940256099942544/...) for debug builds,
# real IDs in production builds
VITE_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
VITE_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
VITE_ADMOB_NATIVE_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Platform flag for dual builds: web (AdSense) vs android (AdMob)
# Set automatically by build:mobile — do not change manually
VITE_PLATFORM=web

# Push notifications — URL of the deployed koyjabo-push Cloudflare Worker
# (scripts/push-worker/README.md). Empty = push disabled (no prompt, no events).
VITE_PUSH_API_URL=

# Community live bus GPS — URL of the deployed koyjabo-bus-live Cloudflare Worker
# (scripts/bus-live-worker/). Empty = falls back to the default workers.dev URL.
VITE_BUS_LIVE_URL=


